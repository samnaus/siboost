# Copy to .env for local development. Never commit real secrets.

# SQLite for local development. On Vercel, use a Postgres URL instead.
# The provider is selected automatically: postgres URLs use PostgreSQL, everything else uses SQLite.
DATABASE_URL="file:./dev.db"

# Public site URL, no trailing slash. Used for canonical links, sitemap and Stripe return URLs.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:4317"

# Shown on the site and in the admin content defaults until edited.
CONTACT_EMAIL="hello@siboost.co.nz"

# Admin area. Use a long random ADMIN_SESSION_SECRET (at least 16 characters).
ADMIN_EMAIL="admin@siboost.test"
ADMIN_PASSWORD="change-me-please"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Stripe. Leave blank until you have TEST keys. Live keys are ignored unless ALLOW_LIVE_STRIPE=true.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional. If empty, the app looks up or creates a 15% exclusive NZ GST tax rate.
STRIPE_GST_TAX_RATE_ID=""
STRIPE_PORTAL_CONFIGURATION_ID=""
# Set to true only after the Stripe account, GST and webhooks have been verified in test mode.
ALLOW_LIVE_STRIPE="false"
# Set to false only if the business is not GST-registered and should not add 15% GST.
CHARGE_GST="true"

# Transactional email. If neither provider is set, messages are printed to the server console.
# Resend takes precedence when both are present.
EMAIL_FROM=""
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""

# Optional analytics. Scripts are not loaded unless these are set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
